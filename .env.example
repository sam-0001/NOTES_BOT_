# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=123456789
STORAGE_GROUP_ID=-100123456789

# ── Cashfree Payment Gateway ──────────────────────────────────────────────────
# Find your API credentials in Cashfree Merchant Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
# Optional: if omitted, CASHFREE_SECRET_KEY is used automatically for webhook verification
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret_here
# Environment: PRODUCTION or SANDBOX (TEST)
CASHFREE_ENV=PRODUCTION
# API version (default: 2023-08-01)
CASHFREE_API_VERSION=2023-08-01

# ── Server ────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://your-server.com
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
